# Bluehost Remote MySQL Configuration
DB_HOST=sh01064.bluehost.com
DB_PORT=3306
DB_USER=your_cpanel_dbuser
DB_PASSWORD=your_db_password
DB_NAME=your_cpanel_dbname
DB_SSL=false

# Production Security Secrets (Required for Vercel deployment - 64-character random string)
ADMIN_JWT_SECRET=generate_a_random_64_character_hex_secret_here

# Canonical Base URL
NEXT_PUBLIC_BASE_URL=https://gta6fanpage.com

# Optional Remote Persistent Storage Configuration (Bluehost SFTP / Custom Upload API)
# BLUEHOST_UPLOAD_ENDPOINT=https://your-domain.com/api/upload.php
# STORAGE_SECRET=your_remote_storage_key
